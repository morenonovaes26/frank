# Copiar para .env e preencher. NÃO versionar o .env.

# Domínio e Cloudflare
DOMAIN=exemplo.com
CLOUDFLARE_TUNNEL_TOKEN=

# Nginx Proxy Manager
NPM_DB_MYSQL_ROOT_PASSWORD=
NPM_DB_MYSQL_PASSWORD=

# n8n
N8N_ENCRYPTION_KEY=
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=

# TheHive / Cortex
THEHIVE_SECRET=
CORTEX_SECRET=
ELASTIC_PASSWORD=

# Chaves de APIs de threat intelligence (ver vulnerabilidades/README.md)
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
GREYNOISE_API_KEY=
PULSEDIVE_API_KEY=
OTX_API_KEY=
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
URLSCAN_API_KEY=
MALWAREBAZAAR_API_KEY=
HYBRID_ANALYSIS_API_KEY=
NVD_API_KEY=
GITHUB_TOKEN=
HIBP_API_KEY=

# Timezone
TZ=America/Sao_Paulo
